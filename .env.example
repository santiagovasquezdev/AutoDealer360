# Desarrollo: true permite ver el catálogo sin instalar MySQL todavía.
# Cambiar a false cuando hayas importado database/autodealer360.sql.
DEMO_MODE=true
NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autodealer360

# Número REAL del concesionario en formato internacional, sin + ni espacios.
# Ejemplo de formato (NO número real): 573XXXXXXXXX
WHATSAPP_NUMBER=
DEALERSHIP_NAME=AutoDealer360

# Fase 3: cuenta Cloudinary (Cloudinary Console > API Keys). Nunca exponer en public/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
